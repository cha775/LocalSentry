{
  "appId": "com.privacyguard.app",
  "appName": "PrivacyGuard",
  "webDir": "dist",
  "backgroundColor": "#07090d",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#07090d"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#07090d",
      "showSpinner": false
    }
  }
}
